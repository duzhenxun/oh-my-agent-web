<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>asr-bridge</string>
	<key>CFBundleIdentifier</key>
	<string>web.ohmyagent.asr-bridge</string>
	<key>CFBundleName</key>
	<string>ASRBridge</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<!-- 后台小工具：不出现在 Dock / 应用切换器里 -->
	<key>LSUIElement</key>
	<true/>
	<!-- TCC 认的是这两把钥匙：少了 usage description 直接 SIGABRT（见 README） -->
	<key>NSMicrophoneUsageDescription</key>
	<string>oh-my-agent-web 需要麦克风，才能把你说的话转成输入框里的文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>oh-my-agent-web 用系统自带的离线语音识别，把你说的话转成输入框里的文字（不联网）。</string>
</dict>
</plist>
