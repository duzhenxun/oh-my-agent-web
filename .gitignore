# 依赖与构建产物（ADR-0010：构建产物一律不入库）
node_modules/
dist/
web/dist/

# 本机运行数据（默认在 ~/.oh-my-agent-web，这里是兜底）
.oh-my-agent-web/
.agent-web/
*.log

# 编辑器与系统
.DS_Store
.idea/
.vscode/

# 本地打包 / 分发产物（Electron 打包、内置 node 运行时、pkg 工作区、electron-builder 输出）
# 注意：根锚定，避免误伤 helper/asr/release/ASRBridge.zip
/electron-dist/
/node-runtime/
/.pkg/
/release/

# 本地运行日志与截图（npm run dev 的输出、UI 验证截图）
.run/

# 临时
.tmp-*
*.tgz

# playwright-cli 的临时产物（页面快照 / 控制台日志），不是源码
.playwright-cli/

# 图表/统计导出（本次会话的临时产物）
out/

# 本地创作 / 出图工地（小说、天气图、小红书文案）：内容和仓库无关，别跟着发版
novel/
weather-charts/
xhs/
