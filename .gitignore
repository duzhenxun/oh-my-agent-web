# 依赖与构建产物（ADR-0010：构建产物一律不入库）
node_modules/
dist/
web/dist/

# 本机运行数据（默认在 ~/.oh-my-agent-web，这里是兜底）
.oh-my-agent-web/
.agent-web/
*.log

# 编辑器与系统
.DS_Store
.idea/
.vscode/

# 本地运行日志与截图（npm run dev 的输出、UI 验证截图）
.run/

# 临时
.tmp-*
*.tgz

# playwright-cli 的临时产物（页面快照 / 控制台日志），不是源码
.playwright-cli/

# 图表/统计导出（本次会话的临时产物）
out/
