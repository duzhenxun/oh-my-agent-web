{
	"name": "oh-my-agent-web",
	"version": "0.1.5",
	"description": "Browser cockpit for the Codex CLI app-server — chat, tool calls, diffs and approvals in one tab",
	"license": "MIT",
	"type": "module",
	"author": "duzhenxun",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/duzhenxun/oh-my-agent-web.git"
	},
	"homepage": "https://github.com/duzhenxun/oh-my-agent-web#readme",
	"bugs": {
		"url": "https://github.com/duzhenxun/oh-my-agent-web/issues"
	},
	"keywords": [
		"codex",
		"codex-cli",
		"openai",
		"app-server",
		"web-ui",
		"ai",
		"chat",
		"cli"
	],
	"bin": {
		"oh-my-agent-web": "bin/oh-my-agent-web.mjs",
		"omaw": "bin/oh-my-agent-web.mjs"
	},
	"main": "bin/oh-my-agent-web.mjs",
	"files": [
		"bin/",
		"dist/",
		"web/dist/",
		"scripts/",
		"shared/protocol.ts",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "cross-env OMAW_DEV_WEB=1 tsx watch server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:web && npm run build:server",
		"build:web": "vite build --config web/vite.config.ts",
		"build:server": "tsc -p tsconfig.server.json",
		"prepack": "npm run build",
		"start": "node bin/oh-my-agent-web.mjs",
		"ws": "node bin/oh-my-agent-web.mjs ws",
		"omaw": "node scripts/omaw.mjs",
		"stop": "node scripts/manage-server.mjs stop",
		"restart": "node scripts/manage-server.mjs restart",
		"smoke": "tsx test/smoke.ts",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit"
	},
	"dependencies": {
		"express": "^4.21.2",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@types/express": "^4.17.23",
		"@types/node": "^22.15.3",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.4.1",
		"cross-env": "^7.0.3",
		"highlight.js": "^11.11.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.4"
	}
}
