{
	"name": "oh-my-agent-web",
	"version": "0.1.0",
	"private": true,
	"bin": {
		"oh-my-agent-web": "dist/server/cli.js",
		"omaw": "dist/server/cli.js"
	},
	"files": [
		"dist",
		"web/dist"
	],
	"description": "oh-my-agent-web — 单机编码智能体工作台（单用户、loopback、对话+文件+终端+会话落盘）",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:server": "node --import tsx --watch server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:server && npm run build:web",
		"build:server": "tsc -p tsconfig.server.json",
		"build:web": "vite build --config web/vite.config.ts",
		"start": "node dist/server/cli.js",
		"stop": "node dist/server/cli.js stop",
		"restart": "node dist/server/cli.js restart",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
		"lint": "oxlint server web/src scripts",
		"lint:fix": "oxlint --fix server web/src scripts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
		"icons": "node scripts/make-icons.mjs"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/web-push": "^3.6.4",
		"@types/ws": "^8.5.0",
		"@vitejs/plugin-react": "^6.0.0",
		"oxlint": "^1.0.0",
		"playwright-core": "^1.64.1",
		"prettier": "^3.4.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"express": "^5.3.0",
		"highlight.js": "^11.12.0",
		"mermaid": "^12.2.0",
		"node-pty": "^1.1.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"web-push": "^3.6.7",
		"ws": "^8.22.0"
	}
}
