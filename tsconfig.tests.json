{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		// web/src/lib/*.ts 会被单测直接引用（如流式增量助手），需要允许显式 .ts 扩展名
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["tests/**/*.ts"]
}
